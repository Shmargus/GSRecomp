# One repository for the collection. Each game folder and engine/ keep their
# own .gitignore for their private and generated material.

# Collection-local inputs and outputs.
/ROMs/
/Saves/
/Releases/
/local/
/Archive/
/*.exe
/*.dll
*.gba
*.rom
*.sav
*.state*

# Per-run debug output a game writes into the folder it was started from.
/recomp_cache/
/recomp_coverage*
/recomp_master_misses*
/hang_dump.log
/hang_trace.csv
*.toml.frag

# Agent instructions, status notes and collection docs stay on disk only.
/AGENTS.md
/STATUS.md
/docs/
/.claude/
.claude/settings.local.json

# Shared artwork: only the launcher logo is public (provenance, see
# The Broken Seal/docs/LEGAL.md).
/assets/*
!/assets/launcher_logo.png
# The Ashley Edition's F1 badge (release switch -AshleyEdition, both games).
!/assets/ashley_edition/

# Python caches.
__pycache__/
*.py[cod]
